{
  "expo": {
    "name": "MOVA$",
    "slug": "movas",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD"
    },
    "ios": {
      "bundleIdentifier": "com.murilobueno.movas",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.murilobueno.movas",
      "adaptiveIcon": {
        "backgroundColor": "#F7F6F2",
        "foregroundImage": "./assets/images/movas-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "contratei",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F6F2",
    "primaryColor": "#F26A3A",
    "web": {
      "output": "static",
      "name": "MOVA$",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b600ab77-9034-4bcb-b3a8-ac4863491a77"
      }
    },
    "owner": "movasapp"
  }
}
